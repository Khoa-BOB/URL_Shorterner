# ==========================================
# UNIVERSAL GITIGNORE TEMPLATE
# ==========================================

# ------------------------------------------
# 1. Operating System Files
# ------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# Linux
.fuse_hidden*
.directory
.trash/

# ------------------------------------------
# 2. IDEs and Code Editors
# ------------------------------------------
# Visual Studio Code
.vscode/
!.vscode/extensions.json
*.code-workspace

# JetBrains (IntelliJ, WebStorm, PyCharm, etc.)
.idea/
*.iws

# Eclipse
.metadata/
.classpath
.project
.settings/

# ------------------------------------------
# 3. Dependencies and Packages
# ------------------------------------------
# Node.js / JavaScript
node_modules/
jspm_packages/
.pnpm-store/

# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
ENV/
env/

# Java
.gradle/
build/
target/
*.class

# Ruby
.bundle/
vendor/bundle/
log/*.log
tmp/

# ------------------------------------------
# 4. Environment Variables and Secrets
# ------------------------------------------
# NEVER commit credentials or API keys to Git
.env
.env.local
.env.*.local
*.pem
*.key
*.secret

# ------------------------------------------
# 5. Logs and Databases
# ------------------------------------------
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Local databases
*.db
*.sqlite
*.sqlite3

# ------------------------------------------
# 6. Build Artifacts and Temp Files
# ------------------------------------------
dist/
out/
bin/
obj/
*.tmp
*.bak